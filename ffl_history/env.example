# ---------------------------------------------------------------------------
# ffl-history settings.
#
# Copy to .env and fill in.  `ffl-history init-env` does this for you and sets
# the file mode to 600, which matters: this file will hold session cookies for
# your ESPN account.
#
# .env is gitignored.  NEVER commit it, and never paste ESPN_S2 or SWID into
# an issue, a screenshot or a pull request - anyone holding them can act as
# you on ESPN.
#
# Everything here is optional: each setting also has a command-line flag, and
# a real environment variable always wins over this file.
# ---------------------------------------------------------------------------

# --- Your league -----------------------------------------------------------

# Numeric league id, from the leagueId= parameter of your ESPN league URL:
#   https://fantasy.espn.com/football/league?leagueId=123456
ESPN_LEAGUE_ID=

# ESPN has required auth cookies on historical seasons since August 2025, even
# for a league you own and even for seasons long finished.
#
# To get them: log in at https://fantasy.espn.com, open your browser's
# developer tools, and go to Application (Chrome) or Storage (Firefox) ->
# Cookies -> https://fantasy.espn.com.  Copy these two values:
#
#   espn_s2  long and URL-encoded (contains %xx).  Paste it verbatim, with no
#            surrounding quotes.
#   SWID     a GUID.  Include the surrounding braces: {1A2B3C4D-....}
#
# They expire every few months.  When they do, requests start failing with an
# access-denied error; refresh both values and re-run.  Nothing is lost - only
# the units that failed are retried.
ESPN_S2=
SWID=

# --- What to fetch ---------------------------------------------------------

# Which seasons to pull.  Accepts '2023', '2018-2024' or '2019,2021,2024'.
# Leave unset (or 'auto') to ask ESPN which seasons your league actually has.
# 2018 is the earliest year this API shape serves.
ESPN_SEASONS=auto

# Highest week to request per season.  Leave unset to cap each season at the
# last week it actually played, which is almost always what you want: ESPN
# answers a request for a future week with today's roster rather than an
# empty one, so an uncapped fetch of an in-progress season would record the
# same lineups once per remaining week.
# MAX_SCORING_PERIOD=

# --- Output ----------------------------------------------------------------

# Comma-separated: sqlite, postgres, csv, json, jsonl, parquet, xlsx, duckdb, raw
FFL_FORMATS=sqlite

# Directory for file outputs.
FFL_OUT_DIR=out

# Where raw ESPN payloads are kept: sqlite (default, no setup) or postgres.
FFL_RAW_STORE=sqlite
FFL_SQLITE_PATH=out/ffl_history.sqlite3

# --- Fetch behaviour -------------------------------------------------------

# Seconds to sleep between requests.  ESPN publishes no quota; be a good
# citizen.  Lower this at your own risk.
REQUEST_DELAY_SECONDS=1.0
REQUEST_TIMEOUT_SECONDS=30
REQUEST_RETRIES=3

# --- Postgres (only needed for --format postgres) --------------------------
#
# The bundled docker-compose.yml reads these too.  Port 5434 is used instead
# of the default 5432 so this stack cannot collide with a Postgres you are
# already running; change it if 5434 is taken on your machine.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_DB=ffl_history
POSTGRES_USER=ffl
POSTGRES_PASSWORD=change-me

# Or point at any Postgres 15+ server with a single connection string, which
# overrides all of the above:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
